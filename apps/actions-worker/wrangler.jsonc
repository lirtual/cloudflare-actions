{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cloudflare-actions",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "workers_dev": false,
  "preview_urls": false,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "keep_vars": false,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  },
  "secrets": {
    "required": [
      "BARK_DEVICE_KEY",
      "BARK_ENCRYPTION_KEY"
    ]
  }
}
